# secrets
.env
.env.*
!.env.example

# python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# chainlit runtime
.chainlit/
.files/
*.db
*.sqlite
*.sqlite3

# The corpus is built per install, not shipped — a clone carries the
# manifest and nothing else, so nobody commits a 500KB djvu dump.
#   raw/     fetched from the manifest by fetch_corpus.py
#   studio/  your own material, placed by hand
#   index/   built from both by ingest.py
corpus/raw/
!corpus/raw/.gitkeep
corpus/studio/
corpus/index/

# conversation logs
logs/

# editors / OS
.idea/
.vscode/
.DS_Store
