[Unit]
Description=Geddes-Folk (Chainlit)
After=network.target

[Service]
Type=simple
User=rob
WorkingDirectory=/mnt/field/projects/geddes-folk
EnvironmentFile=/mnt/field/projects/geddes-folk/.env
ExecStart=/mnt/field/projects/geddes-folk/.venv/bin/chainlit run app.py \
    --host 0.0.0.0 \
    --port 8502 \
    --headless
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
